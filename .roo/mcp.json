{
  "mcpServers": {
    "SharpTools": {
      "type": "stdio",
      "command": "G:\\GameDevelopmentKitAI\\Tools\\MCP\\SharpToolsMCP\\SharpTools.StdioServer\\bin\\Debug\\net8.0\\SharpTools.StdioServer",
      "args": [
        "--log-directory",
        "/var/log/sharptools/",
        "--log-level",
        "Debug"
      ],
      "alwaysAllow": [
        "SharpTool_Undo",
        "SharpTool_ViewDefinition",
        "SharpTool_GetMembers",
        "SharpTool_ReadRawFromRoslynDocument",
        "SharpTool_OverwriteMember",
        "SharpTool_LoadProject",
        "SharpTool_AnalyzeComplexity",
        "SharpTool_LoadSolution",
        "SharpTool_OverwriteRoslynDocument",
        "SharpTool_CreateRoslynDocument",
        "SharpTool_FindAndReplace",
        "SharpTool_ListImplementations",
        "SharpTool_ManageUsings",
        "SharpTool_SearchDefinitions",
        "SharpTool_MoveMember",
        "SharpTool_ManageAttributes",
        "SharpTool_ReadTypesFromRoslynDocument",
        "SharpTool_RequestNewTool",
        "SharpTool_FindReferences",
        "SharpTool_AddMember",
        "SharpTool_RenameSymbol"
      ]
    },
    "excel-stdio": {
      "command": "uvx",
      "args": [
        "excel-mcp-server",
        "stdio"
      ],
      "alwaysAllow": [
        "apply_formula",
        "validate_formula_syntax",
        "format_range",
        "read_data_from_excel",
        "create_workbook",
        "create_worksheet",
        "create_chart",
        "create_pivot_table",
        "copy_worksheet",
        "delete_worksheet",
        "rename_worksheet",
        "get_workbook_metadata",
        "merge_cells",
        "unmerge_cells",
        "copy_range",
        "delete_range",
        "validate_excel_range",
        "list_files",
        "write_data_to_excel"
      ],
      "disabled": false
    },
    "unityMCP": {
      "command": "uv",
      "args": [
        "--directory",
        "G:\\GameDevelopmentKitAI\\Tools\\MCP\\UnityMcpServer\\src",
        "run",
        "server.py"
      ],
      "alwaysAllow": [
        "manage_script",
        "manage_scene",
        "manage_editor",
        "manage_asset",
        "manage_shader",
        "read_console",
        "execute_menu_item",
        "write_to_file",
        "get_workbook_metadata",
        "manage_gameobject"
      ]
    }
  }
}